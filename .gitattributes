# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Explicit line endings for Windows scripts.
*.bat text eol=crlf
*.ps1 text eol=lf

# Properly detect languages on GitHub.
*.h linguist-language=C++
*.usf linguist-language=HLSL
*.ush linguist-language=HLSL

# Git LFS tracking for Unreal binary files.
*.pak filter=lfs diff=lfs merge=lfs -text
*.uasset filter=lfs diff=lfs merge=lfs -text
*.ucas filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.utoc filter=lfs diff=lfs merge=lfs -text

# Git LFS tracking for audio files.
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.opus filter=lfs diff=lfs merge=lfs -text
*.qoa filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

# Git LFS tracking for font files.
*.otf filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text

# Git LFS tracking for image files.
